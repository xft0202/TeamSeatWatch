{
  "name": "teamseatwatch-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@12.4.2",
  "engines": {
    "node": "24.21.0"
  },
  "scripts": {
    "build": "vite build --config vite.owner.config.ts && vite build --config vite.public.config.ts",
    "build:owner": "vite build --config vite.owner.config.ts",
    "build:public": "vite build --config vite.public.config.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "generate:contracts": "node ../tools/generate.mjs --write",
    "check:contracts": "node ../tools/generate.mjs --check"
  },
  "dependencies": {
    "@ant-design/icons": "6.3.4",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/noto-serif-sc": "^5.3.0",
    "@tanstack/react-query": "5.103.1",
    "antd": "6.6.4",
    "openapi-fetch": "0.17.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router": "8.4.0"
  },
  "devDependencies": {
    "@babel/core": "8.0.5",
    "@babel/eslint-parser": "8.0.5",
    "@babel/preset-react": "8.0.1",
    "@babel/preset-typescript": "8.0.1",
    "@eslint/js": "10.0.1",
    "@types/node": "24.13.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "eslint": "10.10.0",
    "typescript": "7.0.2",
    "vite": "8.3.0"
  }
}
